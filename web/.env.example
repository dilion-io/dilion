# Management token for the Dilion management plane (/privacy/v1, /iam/v1).
# DEV ONLY — never ship a service_role JWT or dk_ API key in a production build.
# See web/README.md for a one-liner that mints one for the dev server.
VITE_DILION_SERVICE_TOKEN=

# Anon key sent by supabase-js. The dev server accepts any value.
VITE_DILION_ANON_KEY=dev-anon-key
